<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_project_project_form" model="ir.ui.view">
        <field name="name">project.project.form.inherit.project.git</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='alias_contact']" position="after">
                <field name="git_project_url" widget="url" />
                <field name="git_dev_project_url" widget="url" />
                <!-- Vertical stack: the buttons the platform bridges
                     append after the deploy one land in this container,
                     one per row, instead of scattering in the group grid -->
                <div
                    name="project_git_buttons"
                    colspan="2"
                    class="d-flex flex-column gap-2 align-items-start"
                >
                    <button
                        name="create_project_webhook"
                        string="Create Webhooks"
                        type="object"
                    />
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_project_project_kanban" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.project.git</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="git_project_url" />
                <field name="git_dev_project_url" />
            </xpath>
            <xpath expr="//field[@widget='many2many_tags']" position="after">
                <t t-if="record.git_project_url.value">
                    <div class="text-muted o_row">
                        <span>Prod: </span>
                        <field name="git_project_url" widget="url" />
                    </div>
                </t>
                <t t-if="record.git_dev_project_url.value">
                    <div class="text-muted o_row">
                        <span>Dev: </span>
                        <field name="git_dev_project_url" widget="url" />
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
