<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_project_project_form" model="ir.ui.view">
        <field name="name">project.project.form.inherit.project.gitlab</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_git.view_project_project_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='create_project_webhook']" position="after">
                <field name="gitlab_ci_available" invisible="1" />
                <button
                    name="action_open_ci_job_retry_gitlab"
                    string="Retry CI Job (GitLab)"
                    type="object"
                    invisible="not gitlab_ci_available"
                />
            </xpath>
        </field>
    </record>
</odoo>
