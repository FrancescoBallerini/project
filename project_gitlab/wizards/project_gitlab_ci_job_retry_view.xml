<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_gitlab_ci_job_retry_form" model="ir.ui.view">
        <field name="name">project.gitlab.ci.job.retry.form</field>
        <field name="model">project.gitlab.ci.job.retry</field>
        <field name="arch" type="xml">
            <form string="Retry CI Job">
                <group>
                    <group>
                        <field name="project_id" />
                        <field name="git_project_url_type" widget="radio" />
                    </group>
                    <group>
                        <label for="pipeline_count" />
                        <div class="o_row">
                            <field name="pipeline_count" />
                            <button
                                name="action_load_jobs"
                                string="Reload"
                                type="object"
                                icon="fa-refresh"
                            />
                        </div>
                    </group>
                </group>
                <field name="line_ids">
                    <tree create="false" delete="false" editable="bottom">
                        <!-- What is retried first, where it lives after -->
                        <field name="name" />
                        <field
                            name="status"
                            widget="badge"
                            decoration-success="status == 'success'"
                            decoration-danger="status == 'failed'"
                            decoration-muted="status == 'canceled'"
                        />
                        <field name="stage" />
                        <field name="commit_title" />
                        <field name="pipeline_ref" />
                        <field name="id_pipeline" />
                        <field
                            name="pipeline_status"
                            widget="badge"
                            optional="show"
                            decoration-success="pipeline_status == 'success'"
                            decoration-danger="pipeline_status == 'failed'"
                            decoration-muted="pipeline_status == 'canceled'"
                        />
                        <field name="date" />
                        <field name="id_job" optional="hide" />
                        <field name="commit_sha" optional="hide" />
                        <field name="pipeline_source" optional="hide" />
                        <field name="triggered_by" optional="hide" />
                        <button
                            name="action_open_job"
                            string="Open"
                            title="Open the job on GitLab"
                            type="object"
                            icon="fa-external-link"
                        />
                        <button
                            name="action_retry"
                            string="Retry"
                            type="object"
                            icon="fa-repeat"
                        />
                    </tree>
                </field>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
